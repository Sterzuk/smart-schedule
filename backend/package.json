{
  "name": "smart-schedule-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API для приложения «Умное расписание»",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:generate": "node scripts/prisma-cli.cjs generate",
    "db:push": "node scripts/prisma-cli.cjs db push",
    "db:migrate": "node scripts/prisma-cli.cjs migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "node scripts/prisma-cli.cjs generate && node scripts/prisma-cli.cjs migrate deploy && tsx prisma/seed.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
